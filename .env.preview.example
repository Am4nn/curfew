# Copy to .env.preview and set the local Postgres password. Local preview only.
# Loaded by the preview:* scripts via dotenv-cli, isolated from .env.local.
PREVIEW_MODE=1

# Local Postgres (docker). Same url for all three; the pooled/direct split does
# not apply locally. Setting DATABASE_URL_POOLED too keeps preview off any Neon
# string in .env.local.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
DATABASE_URL_POOLED=postgresql://postgres:PASSWORD@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres

# Auth and email are bypassed in preview; placeholders to pass env validation.
BETTER_AUTH_SECRET=preview-secret-not-used
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=preview
GOOGLE_CLIENT_SECRET=preview
CRON_SECRET=preview
RESEND_API_KEY=preview
EMAIL_FROM=Curfew <preview@curfew.local>
