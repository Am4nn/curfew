# dependencies
node_modules/

# next.js
.next/
out/
build/

# Every environment file, named or not. This listed the three by name, which
# was a list of the files that existed rather than a rule, so a fourth one made
# for an afternoon's diagnosis carried a live database URL into `git add -A`
# and nothing would have stopped it. Anything called .env* holds a secret until
# proven otherwise; .env.example is the one that does not.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# os
.DS_Store
Thumbs.db

# editor
.idea/

# agent tooling
.agents/
.claude/
.design/

# drizzle
drizzle/meta/
.shots/

# LOCAL_MODE evidence store, standing in for the R2 bucket.
.r2-local/
scripts/drift/.seeded.json
.sim/
