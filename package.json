{
  "name": "curfew",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "bun run scripts/migrate.ts",
    "score": "bun run scripts/score.ts",
    "verify": "bun run scripts/verify.ts",
    "auth:generate": "bun x @better-auth/cli generate",
    "preview:migrate": "dotenv -e .env.preview -- bun run scripts/migrate.ts",
    "preview:seed": "dotenv -e .env.preview -- bun run scripts/seed-preview.ts",
    "preview:dev": "dotenv -e .env.preview -- next dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.2",
    "luxon": "^3.5.0",
    "next": "^15.1.6",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.25.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
