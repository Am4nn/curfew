# The key list. Copy it three times and fill each with that environment's values.
#
# All three files are gitignored and hold live secrets. They carry the SAME KEYS
# in the same order; only the values differ. A key missing from one does not fall
# back to a default, it leaks in from .env.local, which Next loads on every
# non-production run. Add a key to one file, add it to all three.
#
#   .env.local        local Postgres, mock data, no sign-in   bun run local
#   .env.preview      the APAC database, real sign-in         bun run dev
#   .env.production   the live database                       bun run migrate:production
#
# Vercel holds the same keys under Preview and Production. See
# .planning/v3/SETUP.md for where each value comes from.

# 1 only in .env.local. Gates mock data and the mock clock, and is inert on
# Vercel because NODE_ENV is "production" there.
LOCAL_MODE=0

# Neon. Pooled for every request, direct for migrations. Local points both at
# docker Postgres, preview at curfew-apac (ap-southeast-1), production at the
# old project until the v3 cutover.
DATABASE_URL_POOLED=
DATABASE_URL_DIRECT=

# Better Auth and Google sign-in. The Google redirect URI must match this origin,
# so each environment needs its own entry in the Google console.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=   # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CRON_SECRET=          # openssl rand -hex 32

# Resend transactional email. Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=Curfew <notices@mail.curfew.amanarya.com>

# Cloudflare R2, evidence photos. Never public: reads are presigned GETs, and the
# secret is shown once by Cloudflare and cannot be read back. curfew-evidence in
# production, curfew-evidence-dev everywhere else.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=curfew-evidence-dev
R2_ENDPOINT=          # https://<account-id>.r2.cloudflarestorage.com

# Upstash Redis, rate limiting. The REST pair, not the Redis protocol one.
# Blank means no limiter, not an open one.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
