# Copy to .env.local and fill in. See PLAN.md §0 for where each value comes from.

DATABASE_URL=       # Neon pooled connection string (host contains -pooler)
DIRECT_URL=         # Neon direct connection string, migrations only

BETTER_AUTH_SECRET=  # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CRON_SECRET=         # openssl rand -hex 32

# Resend transactional email. Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=Curfew <notices@mail.curfew.amanarya.com>
